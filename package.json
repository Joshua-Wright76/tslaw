{
  "name": "tslaw",
  "version": "0.1.0",
  "description": "Verified TypeScript: write laws about pure TypeScript functions and have Z3 prove them at compile time",
  "keywords": ["typescript", "formal-verification", "z3", "smt", "verification", "proof", "static-analysis"],
  "license": "MIT",
  "author": "Joshua Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joshua-Wright76/tslaw.git"
  },
  "bugs": "https://github.com/Joshua-Wright76/tslaw/issues",
  "homepage": "https://github.com/Joshua-Wright76/tslaw#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tslaw": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prove": "cd proofs && lean Core.lean",
    "tslaw": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^3.2.0"
  }
}
